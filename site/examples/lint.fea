languagesystem DFLT dflt;

@lowercase = [a b c d e];
@smallcaps = [a.sc b.sc c.sc e.sc];
@marks = [acutecomb gravecomb acutecomb];

feature smpc {
    sub @lowercase by @smallcaps;
    sub agrve by agrave.sc;
    sub f i by f_i;
} smpc;

feature kern {
    pos T o -60;
    pos T o -45;
} kern;

feature calt {
    sub a' by a.alt;
    sub a' c by a.short;
} calt;
